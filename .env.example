# Copy to .env and fill in real values. Never commit .env.
# This file is only for NEXT_PUBLIC_* build-time values.
# Server-side secrets go in .dev.vars instead — see .dev.vars.example.

# Cloudflare Turnstile site key — public, safe to expose client-side
# Dashboard → Turnstile → your widget
# For local development use Cloudflare's always-pass test key
# 1x00000000000000000000AA — it works on any hostname, so localhost doesn't
# need an allowlist entry on the real widget. Pair it with the matching test
# secret in .dev.vars; a real key and a test secret never verify together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Svitanok status endpoint — public, read client-side from the work section
# Expects GET -> { "lastBriefingAt": "<ISO-8601>" }
# Leave empty and the live-pulse line simply doesn't render. Its origin is added
# to connect-src at build time, so changing it needs a rebuild, not just a
# redeploy of secrets.
NEXT_PUBLIC_SVITANOK_STATUS_URL=

# Cloudflare Web Analytics beacon token — public, ships in the page source
# Dashboard → Analytics & Logs → Web Analytics → Add site → copy the token
# Leave empty to skip loading the beacon script entirely
NEXT_PUBLIC_CF_BEACON_TOKEN=
